# Backend-specific ignores are in backend/.gitignore

# Global ignores
.env*
!.env.example

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# Logs
logs/
*.log

# DS store
**/.DS_Store

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
